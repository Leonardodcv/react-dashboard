# URL base del backend v14.4 (sin slash final)
VITE_API_BASE_URL=http://localhost:8000

# Endpoint público de configuración del backend.
# Se usa para leer la versión de API y el límite de /api/proyeccion/.
VITE_CONFIG_ENDPOINT=/api/v1/config/

# Ruta que devuelve la serie real/proyectada.
VITE_PROJECTION_ENDPOINT=/api/proyeccion/

# Rango que aparece seleccionado al abrir Analíticas.
# El usuario puede cambiarlo desde los dos calendarios de la interfaz.
# La fecha inicial nunca puede ser anterior al 2026-04-01.
VITE_PROJECTION_FECHA_INICIO=2026-04-01
VITE_PROJECTION_FECHA_FIN=2026-06-16

# Las tres consultas conservan su estación/producto y reciben
# dinámicamente fecha_inicio y fecha_fin desde los calendarios:
# TGF · Gasolina regular -> estacion=2&codprd=1
# TGF · Diesel           -> estacion=2&codprd=3
# TankFarm · Diesel      -> estacion=1&codprd=3
#
# Backend v14.4 permite que fecha_fin esté más allá de la última fecha real.
# En esos días /api/proyeccion/ devuelve real:null y el frontend lo muestra
# como dato no disponible, nunca como 0.
